{
  "extends": "@samhenrytech/eslint-config/tsconfig.base.json",
  "compilerOptions": {
    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["node", "vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["**/*", "**/.*"],
  "exclude": ["node_modules", "dist", "src/archive for editable"]
}
